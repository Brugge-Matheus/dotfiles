// Waybar — barra solida dark (icones via codepoint)
{
  // "overlay": fica ACIMA de janelas em fullscreen (a camada "top" renderiza
  // ATRAS do fullscreen no Hyprland -> a barra revelada no hover nao apareceria).
  // Continua reservando 32px no uso normal, entao nao cobre as janelas tiladas.
  "layer": "overlay",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "custom/ws1",
    "custom/ws2",
    "custom/ws3",
    "custom/ws4",
    "custom/ws5",
    "custom/ws6",
    "custom/ws7",
    "custom/ws8",
    "custom/ws9",
    "custom/ws10",
    "custom/spotify",
    "tray"
  ],
  "modules-center": [
    "wlr/taskbar",
    "cpu",
    "memory",
    "temperature"
  ],
  "modules-right": [
    "custom/weather",
    "backlight",
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/battery",
    "custom/clock",
    "custom/power"
  ],
  "custom/distro": {
    "format": "",
    "tooltip": false,
    "on-click": "walker"
  },
  "custom/ws1": { "exec": "~/.config/waybar/scripts/ws-button.sh 1", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 1" },
  "custom/ws2": { "exec": "~/.config/waybar/scripts/ws-button.sh 2", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 2" },
  "custom/ws3": { "exec": "~/.config/waybar/scripts/ws-button.sh 3", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 3" },
  "custom/ws4": { "exec": "~/.config/waybar/scripts/ws-button.sh 4", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 4" },
  "custom/ws5": { "exec": "~/.config/waybar/scripts/ws-button.sh 5", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 5" },
  "custom/ws6": { "exec": "~/.config/waybar/scripts/ws-button.sh 6", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 6" },
  "custom/ws7": { "exec": "~/.config/waybar/scripts/ws-button.sh 7", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 7" },
  "custom/ws8": { "exec": "~/.config/waybar/scripts/ws-button.sh 8", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 8" },
  "custom/ws9": { "exec": "~/.config/waybar/scripts/ws-button.sh 9", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 9" },
  "custom/ws10": { "exec": "~/.config/waybar/scripts/ws-button.sh 10", "return-type": "json", "interval": 5, "signal": 9, "format": "{}", "on-click": "~/.config/waybar/scripts/ws-focus.sh 10" },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "interval": 3,
    "format": " {used:0.1f}G"
  },
  "temperature": {
    "thermal-zone": 6,
    "critical-threshold": 82,
    "format": " {temperatureC}°",
    "format-critical": " {temperatureC}°"
  },
  "backlight": {
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " 0%",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\n{num_connections} conectado(s)",
    "on-click": "blueman-manager"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-disconnected": "Desconectado",
    "on-click": "ghostty -e nmtui"
  },
  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery-status.sh",
    "return-type": "json",
    "interval": 15,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/powerprofile.sh"
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "custom/spotify": {
    "exec": "~/.config/waybar/scripts/spotify.sh",
    "return-type": "json",
    "interval": 2,
    "max-length": 45,
    "on-click": "~/.config/waybar/scripts/spotify-open.sh",
    "on-click-right": "playerctl -p spotify play-pause",
    "escape": true
  },
  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 900,
    "on-click": "~/.config/waybar/scripts/weather.sh"
  },
  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "interval": 10,
    "format": " {}",
    "tooltip": false,
    "on-click": "gsimplecal"
  }
}
