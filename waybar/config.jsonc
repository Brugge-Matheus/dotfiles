// Waybar — barra solida dark (icones via codepoint)
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "hyprland/workspaces",
    "custom/spotify",
    "tray"
  ],
  "modules-center": [
    "cpu",
    "memory",
    "temperature"
  ],
  "modules-right": [
    "custom/weather",
    "backlight",
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "custom/clock",
    "custom/power"
  ],
  "custom/distro": {
    "format": "",
    "tooltip": false,
    "on-click": "walker"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "interval": 3,
    "format": " {used:0.1f}G"
  },
  "temperature": {
    "thermal-zone": 7,
    "critical-threshold": 82,
    "format": " {temperatureC}°",
    "format-critical": " {temperatureC}°"
  },
  "backlight": {
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " 0%",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\n{num_connections} conectado(s)",
    "on-click": "blueman-manager"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-disconnected": "Desconectado",
    "on-click": "ghostty -e nmtui"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "on-click": "~/.config/waybar/scripts/powerprofile.sh",
    "tooltip-format": "{capacity}% ({time})\nClique: perfil de energia"
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "custom/spotify": {
    "exec": "~/.config/waybar/scripts/spotify.sh",
    "return-type": "json",
    "interval": 2,
    "max-length": 45,
    "on-click": "~/.config/waybar/scripts/spotify-open.sh",
    "on-click-right": "playerctl -p spotify play-pause",
    "escape": true
  },
  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 900,
    "on-click": "~/.config/waybar/scripts/weather.sh"
  },
  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "interval": 10,
    "format": " {}",
    "tooltip": false,
    "on-click": "gsimplecal"
  }
}
