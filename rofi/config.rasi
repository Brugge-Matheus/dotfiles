/* =====================================================================
 *  rofi — launcher principal (SUPER + Espaço)
 *  Layout minimalista/quadrado · JetBrainsMono Nerd Font · ícones Papirus.
 *  rofi 2.0+ roda nativo no Wayland. Modo: drun (apps).
 *
 *  PALETA (troque a linha @import abaixo p/ mudar de tema):
 *    @import "colors-brugge.rasi"   -> Terminal Refinado (design do blog)  [ATIVA]
 *    @import "colors-ayu.rasi"     -> ayu-dark (LazyVim)
 *    @import "colors-black.rasi"   -> black minimalista
 * ===================================================================== */
@import "colors-brugge.rasi"

configuration {
    /* Modos das ABAS (Tab / Shift+Tab alternam): Apps, Arquivos, Comandos (script proprio, no lugar do `run`
     * nativo que listava ~3.700 executaveis), Janelas (script proprio: PID, icone e kill, no lugar do `window` nativo), Calculadora e Tradutor (scripts em rofi/scripts/). */
    modes:                       "drun,file-browser-extended,cmds:~/.config/rofi/scripts/rofi-cmds.sh,win:~/.config/rofi/scripts/rofi-windows.sh,calcd:~/.config/rofi/scripts/rofi-calc-dev.sh,trans:~/.config/rofi/scripts/rofi-translate.sh";
    font:                        "JetBrainsMono Nerd Font 11";
    show-icons:                  true;
    icon-theme:                  "Papirus-Dark";
    drun-display-format:         "{name}";
    /* Abas = so o icone (glifo Nerd Font; a barra mode-switcher mostra estes rotulos) */
    display-drun:                "";
    display-file-browser-extended: "";
    display-cmds:                "";
    display-win:                 "";
    display-calcd:               "";
    display-trans:               "";
    terminal:                    "ghostty";
    hover-select:                true;

    /* Comandos com ">" em QUALQUER aba. A parte "o > deixa de filtrar a lista" NAO vem deste arquivo: o rofi nao aceita
     * `matching-negate-char` em .rasi (marcado "unsupported"), so na linha de comando -> o launcher e aberto com
     * `rofi -show drun -matching-negate-char '>'` (variavel `menu` em hypr/hyprland.lua). O ">" vira o caractere de negacao:
     * a palavra colada nele (">kill") e tratada como "nao contem", o que quase sempre passa, entao o que vem DEPOIS do ">"
     * nao esconde mais a lista; o texto antes do ">" continua filtrando. Executar = Ctrl+Enter. Nas abas nativas (Apps/
     * Arquivos) quem recebe o texto e o rofi-dispatch.sh (run-command); nas de script, o proprio script.
     * Tradeoff: o "-" deixa de negar ("-foo" nao exclui mais). */
    run-command:                 "sh -c '$HOME/.config/rofi/scripts/rofi-dispatch.sh \"$1\"' _ \"{cmd}\"";
    /* kb-custom-1/2 NAO sao definidos aqui: o navegador de arquivos usa Alt+1 (abrir sem fechar) e Alt+2 (ocultos).
     * A calculadora so usa Ctrl+Delete no atalho dedicado SUPER+= (rofi-ext.sh passa as teclas la). */

    /* Tab / Shift+Tab TROCAM DE MODO (Apps -> Arquivos -> Executar -> Janelas -> ...) em vez de andar pela lista.
     * A lista continua com Setas / Ctrl+j / Ctrl+k / Ctrl+n / Ctrl+p. (Os atalhos antigos de modo seguem valendo.)
     * kb-element-next/prev ficam vazios: senao Tab seria "de dois donos" e o rofi recusa/ignora. */
    kb-mode-next:              "Tab,Shift+Right,Control+Tab";
    kb-mode-previous:          "ISO_Left_Tab,Shift+Left,Control+ISO_Left_Tab";
    kb-element-next:           "";
    kb-element-prev:           "";
}

/* As cores (bg, fg, accent, sel, ...) vem do @import la em cima. */
* {
    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            34%;
    border:           1px;
    border-color:     @border-c;
    border-radius:    0px;
    background-color: @bg;
    padding:          0;
}

mainbox {
    padding:  14px;
    spacing:  12px;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

/* Linha de mensagem: o rofi so a mostra se o mainbox a incluir. Ela leva a ajuda de cada aba e o RESULTADO das acoes
 * (ex.: "= 8 (copiado)", "✓ kill -9 em Zen Browser (PID 1234)"). Some sozinha quando a aba nao manda mensagem. */
message {
    padding:          8px 14px;
    border:           0px;
    background-color: @bg-alt;
}
textbox {
    text-color:       @fg-dim;
    background-color: transparent;
}

/* Barra de abas dos modos = pequenos icones (Apps/Calc/Files/Traduzir/...).
 * expand:false faz cada botao encolher pro tamanho do icone (nao estica). */
mode-switcher {
    expand:       false;
    spacing:      4px;
    margin:       10px 0px 0px 0px;
    padding:      10px 0px 0px 0px;
    border:       1px 0px 0px 0px;
    border-color: @border-c;
}
button {
    expand:           false;
    padding:          12px 12px;   /* > limiar de corte (~10px) p/ o glifo aparecer inteiro */
    border-radius:    0px;
    background-color: transparent;
    text-color:       @fg-dim;     /* icone inativo: cinza apagado */
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           pointer;
}
/* Aba ativa = icone ACESO (ambar do ayu), sem caixa de fundo -> nada pra
 * (des)centralizar; o glifo so muda de cor. */
button selected {
    background-color: transparent;
    text-color:       @accent;
}

inputbar {
    spacing:          10px;
    padding:          12px 14px;   /* sem icone de prompt; folga define a altura da busca */
    border-radius:    0px;
    background-color: @bg-alt;
    children:         [ "entry" ];
}

entry {
    text-color:        @fg;
    /* o rofi NAO aceita placeholder por aba (tema estatico; o texto do prompt tambem vira o rotulo do botao do rodape).
     * Por isso um unico texto que vale p/ as 4 abas de busca (Apps/Arquivos/Janelas/Executar); a Calculadora e o
     * Tradutor explicam o uso na linha de mensagem logo abaixo (emitida pelos scripts). Mais longo que isso o rofi corta no meio. */
    placeholder:       "Buscar app, arquivo, janela ou comando…";
    placeholder-color: @fg-dim;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:          6;
    columns:        1;
    fixed-height:   true;    /* sempre 8 linhas: janela nao muda de tamanho */
    scrollbar:      false;
    spacing:        2px;
    dynamic:        false;   /* nao encolhe ao filtrar -> sem animacao de compactar */
    border:         0px;     /* remove a borda tracejada do tema default do rofi */
}

element {
    padding:          9px 12px;
    spacing:          12px;
    border-radius:    0px;
    background-color: transparent;
    text-color:       @fg;
}

/* Fundo fixado explicitamente em CADA estado — senao o tema default do rofi
 * vence e pinta as linhas normais de claro (texto claro sobre claro = ilegivel). */
element normal.normal    { background-color: transparent; text-color: @fg;     }
element alternate.normal { background-color: transparent; text-color: @fg;     }
element normal.active    { background-color: transparent; text-color: @accent; }
element normal.urgent    { background-color: transparent; text-color: @urgent; }
element selected.normal  { background-color: @sel;         text-color: @sel-fg; }
element selected.active  { background-color: @sel;         text-color: @sel-fg; }
element selected.urgent  { background-color: @urgent;     text-color: #ffffff; }

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
