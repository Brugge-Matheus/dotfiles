[Unit]
# Instala em ~/.config/systemd/user/hyprlock-cover.service e habilita com:
#   systemctl --user enable --now hyprlock-cover.service
# Roda o cover-daemon.sh, que mantem ~/.cache/hyprlock/cover.img com a capa da
# faixa atual (ver scripts/cover-daemon.sh e [[arch-hyprlock-now-playing]]).
Description=Mantem a capa da musica atual pronta p/ o hyprlock (now-playing)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/hypr/scripts/cover-daemon.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
